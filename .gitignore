########################
# FMOD Unity Integration
########################

# Local FMOD Unity plugin cache (regenerated per machine)
Assets/Plugins/FMOD/Cache/

# Local FMOD editor log
fmod_editor.log

# FMOD Unity generated settings backups (if any)
Assets/Plugins/FMOD/Resources/*_backup.asset
Assets/Plugins/FMOD/Resources/*_backup.asset.meta

########################
# FMOD Studio Project
########################

# FMOD build output (banks, GUIDs, cache)
gmtk-2025-fmod/Build/**
gmtk-2025-fmod/.cache/**
gmtk-2025-fmod/*.fspro.user

# Temporary local data FMOD creates
gmtk-2025-fmod/.unsaved/**
gmtk-2025-fmod/Temp/**
gmtk-2025-fmod/Logs/**

########################
# FMOD Audio Assets
########################

# Ignore built audio banks (Unity already gets these from StreamingAssets)
/Assets/StreamingAssets/*.bank
/Assets/StreamingAssets/*.fsb

